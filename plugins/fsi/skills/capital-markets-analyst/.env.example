# fsi-capital-markets-analyst: configuration.
#
# Copy to `.env` for Full Setup and the live evaluation. Quick Start needs none of this.
# Authentication is Application Default Credentials (`gcloud auth application-default login`).
# Never create or commit service account keys.

# --- Runtime ---
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=<TODO: your-gcp-project-id>

# Model serving location. `global` is recommended for Gemini text models; a model that is
# published in `global` may not be published in a single region.
GOOGLE_CLOUD_LOCATION=global

# --- Models ---
# Agent model. Any Gemini text model published at $GOOGLE_CLOUD_LOCATION for your project.
GEMINI_MODEL=gemini-3.8-flash

# Rubric judge for `scripts/eval_runner.py --live`. Leave blank to reuse GEMINI_MODEL; a
# different model from the agent is preferable so the agent does not grade itself.
FSI_JUDGE_MODEL=

# Second-model review of the figures in an answer (scripts/answer_review.py): a note under
# each chat answer that used a tool, and a gate in `scripts/eval_runner.py --live`.
# Use a model other than GEMINI_MODEL. Leave blank for the default, gemini-3.7-flash.
FSI_REVIEWER_MODEL=
# Set false to answer in the chat without the review (one model call less per answer).
FSI_ANSWER_REVIEW=true

# --- BigQuery (Full Setup) ---
FSI_BQ_DATASET=fsi_capital_markets
FSI_BQ_GRAPH_NAME=disclosed_supply_chain_graph

# --- Cloud Storage (used by scripts/cleanup.py) ---
FSI_GCS_STAGING_BUCKET=
FSI_GCS_AUDIT_BUCKET=

# --- Sign-off policy (read by scripts/server.py, never taken from the browser) ---
FSI_DUAL_CONTROL=true
# Set true to refuse sign-off on an offline-only evaluation.
FSI_REQUIRE_LIVE_EVAL=false

# --- SEC EDGAR ---
# SEC asks for a User-Agent that names you and a contact address, and for no more than 10
# requests per second. Format: "Your Organisation contact@your-domain". An empty value and a
# placeholder address are refused. Needed to rebuild the bundled data, and for live lookups.
SEC_EDGAR_USER_AGENT=
# Set true to let the agent read SEC EDGAR at run time for the reported figures of a company
# outside the bundle (scripts/sec_lookup.py). Off by default; the evaluation always runs with it off.
FSI_SEC_LIVE_LOOKUP=false
# Where the records of looked-up companies are kept. Blank means _output/company_store.
FSI_COMPANY_STORE_DIR=

# --- Google Sheet (optional) ---
# The one Sheet the agent may write the scenario model into and read the scenario back from
# (scripts/sheets_sync.py): its id or its link. Blank means none. A person creates the Sheet and
# shares it, as Editor, with the service account below (or with the identity the skill runs as).
FSI_SHEET_ID=
# Service account to act as for Google Sheets when the skill does not already run as it. Your own
# identity needs roles/iam.serviceAccountTokenCreator on it. No key file is used.
FSI_SHEETS_SERVICE_ACCOUNT=
# Pause in seconds after each row when the model is written to the Sheet, so someone watching sees the
# rows arrive (0 to 1). Blank: the chat tool writes in one request and the workstation tab uses 0.15.
FSI_SHEET_ROW_PACE_SECONDS=
